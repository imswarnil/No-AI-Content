# --- Database (Neon) ---
# Connection string from the Neon dashboard / `neonctl connection-string`.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Admin dashboard ---
# A secret token you choose. Required to view the tracking dashboard at /dashboard.
ADMIN_TOKEN="change-me-to-a-long-random-string"

# --- Public site URL (for SEO: canonical, sitemap, JSON-LD, Open Graph) ---
# Production domain for NAC.
NEXT_PUBLIC_SITE_URL="https://nac.imswarnil.com"

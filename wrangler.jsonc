{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "no-ai-content",
  "main": ".open-next/worker.js",

  // nodejs_compat is required by the OpenNext adapter, and the compatibility
  // date must be 2024-09-23 or later for Next.js to work on workerd.
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }

  // Secrets (DATABASE_URL, ADMIN_TOKEN, ANTHROPIC_API_KEY) are NOT set here —
  // they are uploaded with `wrangler secret put NAME` so they never enter the
  // repository. NEXT_PUBLIC_SITE_URL is different: it is inlined at build time,
  // so it belongs in the build environment, not in a secret.
}
